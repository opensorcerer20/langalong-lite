# Committed as documentation. Copy to .env.local, which is gitignored, and set
# whatever you need — .env.local overrides this file and is never shared.
#
#     cp .env.example .env.local

# Port for `npm run dev`. Unset, Vite picks its own (5173, or the next free one
# above it). Set this to claim a port that does not collide with other dev
# servers on your machine; the dev server then fails loudly on a collision
# instead of silently moving to a different port.
#
# `npm run preview` uses this port plus one.
# DEV_PORT=5173
