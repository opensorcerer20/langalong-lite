{
  "name": "tsumiki",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Japanese sentence-building app for English-speaking learners.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "import": "vite-node scripts/importScenario.ts --",
    "font": "vite-node scripts/font.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stylexjs/stylex": "0.18.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "unplugin-stylex": "^0.6.3",
    "vite": "^7.0.0",
    "vite-node": "^3.0.0",
    "vitest": "^3.0.0",
    "zod": "^4.5.4"
  }
}
